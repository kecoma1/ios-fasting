    "Badges mark time since your fast began. Metabolic changes are gradual and depend on your meals, activity and health; the app does not measure them or confirm ketosis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Badges mark time since your fast began. Metabolic changes are gradual and depend on your meals, activity and health; the app does not measure them or confirm ketosis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las insignias indican el tiempo desde que comenzó tu ayuno. Los cambios metabólicos son graduales y dependen de tus comidas, actividad y salud; la app no los mide ni confirma la cetosis."
          }
        }
      }
    },
