    "The 8-, 12- and 16-hour checkpoints are approximate educational references. The 24-, 48- and 72-hour badges record elapsed time. None of these badges recommends a fasting duration.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 8-, 12- and 16-hour checkpoints are approximate educational references. The 24-, 48- and 72-hour badges record elapsed time. None of these badges recommends a fasting duration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hitos de 8, 12 y 16 horas son referencias educativas aproximadas. Las insignias de 24, 48 y 72 horas registran tiempo transcurrido. Ninguna de estas insignias recomienda una duración de ayuno."
          }
        }
      }
    },
